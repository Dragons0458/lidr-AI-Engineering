# Session 15 failure-mode fixture 5 — token mismatch.
#
# Symptom: stack is `healthy`, every call returns 401.
# Cause: `AI_SERVICE_TOKEN` and `ESTIMATE_API_KEY` hold different values.
# Streamlit sends one, FastAPI checks the other.
#
# Silent variant in this repo: `require_service_token` fails *closed* when
# no token is configured (blank key → 401 on every gated route). The course
# stack treated an empty token as "gate off".
#
# Compare with `.env.example`: both names share `demo-estimate-key`.

AI_SERVICE_TOKEN=demo-estimate-key
ESTIMATE_API_KEY=some-other-key
RETRIEVAL_API_KEY=demo-retrieval-key
